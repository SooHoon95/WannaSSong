# Vercel KV (Upstash REST). Vercel 스토어 연동 시 자동 주입되는 이름 그대로.
WANNASONG_REDIS_REST_KV_REST_API_URL=
WANNASONG_REDIS_REST_KV_REST_API_TOKEN=

# Java realtime(Socket.IO) 서버 주소. 비우면 UI는 "연결 중" 상태로 REST 기능만 동작.
NEXT_PUBLIC_REALTIME_URL=

# QR·공유용 외부 주소 (배포 URL). 비우면 /api/info 가 LAN 주소만 준다.
PUBLIC_URL=

# YouTube Data API v3. 비우면 /api/ytsearch 가 NO_API_KEY 를 돌려주고 검색 탭은 숨겨진다.
YT_API_KEY=

# 스피커 키. /api/feedback 열람 검증에만 쓴다(재생 권한의 진실은 Java 서버).
SPEAKER_KEY=

# 로컬 dev 포트 (/api/info 의 LAN URL 계산용). Vercel 에서는 불필요.
PORT=3000
