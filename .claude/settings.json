{
  "permissions": {
    "allow": [
      "Bash(node .claude/harness/harness-check.mjs*)",
      "Bash(corepack *)",
      "Bash(pnpm *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm install*)",
      "Bash(npx tsc*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sf http://localhost:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/harness/harness-check.mjs\" --session",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/harness/harness-check.mjs\" --hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
